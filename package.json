{
  "name": "scampedia-website",
  "version": "1.0.0",
  "private": true,
  "description": "Scampedia static site + daily AI-researched scam entry pipeline",
  "scripts": {
    "generate-daily-scam": "node scripts/generate-daily-scam.js",
    "build:scams": "node scripts/build-scam-pages.js",
    "build:digest": "node scripts/build-weekly-digest.js",
    "build:learn": "node scripts/build-learn-pages.js",
    "check-content": "node scripts/check-content-health.js",
    "build": "npm run check-content && npm run build:scams && npm run build:learn",
    "rollback:last-entry": "node scripts/rollback-last-entry.js",
    "test": "node --test --test-concurrency=1 '**/__tests__/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "ajv": "8.20.0",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "dotenv": "^16.4.5"
  }
}
