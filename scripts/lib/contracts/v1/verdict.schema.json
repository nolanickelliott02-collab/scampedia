{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officialverifyguard.com/contracts/v1/verdict.schema.json",
  "title": "Verdict",
  "description": "One answer for one check, built from ThreatSignals. checkLevel says whether it was a basic check (on-device feed and model only) or a full check (server detectors).",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "confidence", "checkLevel", "reasons", "signals", "weightsVersion", "createdAt"],
  "properties": {
    "level": { "$ref": "common.schema.json#/$defs/verdictLevel" },
    "risk": { "oneOf": [{ "$ref": "common.schema.json#/$defs/probability" }, { "type": "null" }] },
    "confidence": { "$ref": "common.schema.json#/$defs/probability" },
    "checkLevel": { "enum": ["basic", "full"] },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reasonCode", "signalIndex"],
        "properties": {
          "reasonCode": { "$ref": "common.schema.json#/$defs/reasonCode" },
          "signalIndex": { "type": "integer", "minimum": 0, "description": "The ThreatSignal this reason came from. No reason without a signal." },
          "detector": { "type": "string" },
          "inputType": { "$ref": "common.schema.json#/$defs/inputType" },
          "contribution": { "oneOf": [{ "type": "number" }, { "type": "null" }] }
        }
      }
    },
    "signals": { "type": "array", "items": { "$ref": "threat-signal.schema.json" } },
    "weightsVersion": { "type": "string", "minLength": 1 },
    "modelVersion": { "$ref": "common.schema.json#/$defs/modelVersionId" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    { "if": { "properties": { "level": { "const": "unknown" } } }, "then": { "properties": { "confidence": { "const": 0 } } } }
  ]
}
